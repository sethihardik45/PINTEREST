GEMINI_API_KEY=your_gemini_api_key_here

# Buffer API — get a token at https://publish.buffer.com/developers/apps
# Connect your Pinterest account inside Buffer first (Buffer → Settings → Channels).
BUFFER_ACCESS_TOKEN=

# ---------- Local runs of pin_maker.py only (GitHub Actions sets these automatically) ----------
# Personal access token with `contents: write` on the target repo.
GITHUB_TOKEN=
# owner/repo of the repo that will host the generated image on the `images` branch.
GITHUB_IMAGES_REPO=sethihardik45/Pinterest
# Optional overrides (defaults shown):
# GITHUB_IMAGES_BRANCH=images
# GITHUB_IMAGES_PATH=latest.png

# ---------- Optional Buffer/Pinterest overrides (GitHub: set as repo Variables, not Secrets) ----------
# BUFFER_CHANNEL_NAME=psychicslumus
# BUFFER_BOARD_SERVICE_ID=1147081036281133546   # force a specific Pinterest board
# BUFFER_TITLE=Free Chat with Psychics
# BUFFER_LINK=https://lumusapp.com/81vh/pin_social

# ---------- Legacy (only used by the Flask UI) ----------
# If your Flask server is publicly reachable (e.g. via ngrok), set this so
# Buffer fetches the image directly from your server. Otherwise the image is
# auto-uploaded to catbox.moe as a fallback.
PUBLIC_BASE_URL=
